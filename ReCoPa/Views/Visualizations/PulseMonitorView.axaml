<UserControl
    x:Class="ReCoPa.Views.Visualizations.PulseMonitorView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:lvc="using:LiveChartsCore.SkiaSharpView.Avalonia"
    xmlns:vm="clr-namespace:ReCoPa.ViewModels.Visualizations"
    x:DataType="vm:PulseMonitorViewModel">

    <!-- WICHTIG: kein <UserControl.DataContext> Sample-Zeug -->

    <lvc:CartesianChart
        Margin="20"
        Background="#333333"
        ZoomMode="Both"
        TooltipPosition="Hidden"
        Series="{Binding Series}"
        XAxes="{Binding XAxes}"
        YAxes="{Binding YAxes}" />
</UserControl>