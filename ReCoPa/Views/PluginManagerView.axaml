<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:ReCoPa.ViewModels"
             mc:Ignorable="d"
             d:DesignWidth="800"
             d:DesignHeight="450"
             x:Class="ReCoPa.Views.PluginManagerView"
             x:DataType="vm:PluginManagerViewModel">

    <StackPanel Margin="16" Spacing="12">

        <TextBlock Text="Installed Plugins"
                   FontSize="20"
                   FontWeight="Bold"/>

        <ListBox ItemsSource="{Binding Plugins}">
            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:PluginItemViewModel">
                    <Border Padding="8"
                            BorderBrush="#444"
                            BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="{Binding Name}"
                                       FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding Version}"
                                       FontSize="12"
                                       Opacity="0.7"/>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

    </StackPanel>
</UserControl>