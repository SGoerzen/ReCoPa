<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:ReCoPa.Views"
        xmlns:vm="clr-namespace:ReCoPa.ViewModels"
        x:Class="ReCoPa.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        xmlns:sukiUi="clr-namespace:SukiUI.Controls;assembly=SukiUI"
        Width="1000"
        Height="700"
        Title="ReCoPa V2"
        Icon="/Assets/app-icon.png">

    <ScrollViewer>
        <Border Padding="20" Classes="card">
            <StackPanel Spacing="16">

                <!-- Title -->
                <TextBlock Text="Connected Clients"
                           FontSize="22"
                           FontWeight="Bold"/>

                <!-- Clients table -->
                <views:ClientsTableView DataContext="{Binding ClientsTableViewModel}" />

                <!-- Quit app -->
                <Button Content="Quit App"
                        HorizontalAlignment="Left"
                        Command="{Binding QuitAppCommand}" />

            </StackPanel>
        </Border>
    </ScrollViewer>
</Window>