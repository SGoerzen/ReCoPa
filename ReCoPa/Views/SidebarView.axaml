<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:ReCoPa.Views"
             xmlns:material="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:global="clr-namespace:"
             x:Class="ReCoPa.Views.SidebarView"
             x:DataType="global:SidebarViewModel">

    <DockPanel LastChildFill="True">

        <!-- Actions bottom -->
        <Border DockPanel.Dock="Bottom" 
                Classes="card" 
                Margin="0,5,0,0">
            <StackPanel Spacing="10">
                <TextBlock Text="Session Actions" FontWeight="SemiBold" />

                <Button Classes="secondary"
                    IsEnabled="{Binding IsEyeTrackingEnabled}"
                    ToolTip.Tip="Eye tracking not available on this device"
                    Command="{Binding StartEyeCalibrationCommand, RelativeSource={RelativeSource AncestorType=views:SidebarView}}">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <material:MaterialIcon Kind="Eye" Width="18" Height="18" />
                        <TextBlock Text="Start Eye Calibration" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                    <Button Grid.Column="0" Classes="secondary"
                            Background="{StaticResource AppWarningBackground}"
                            IsEnabled="{Binding IsTrackingRunning, RelativeSource={RelativeSource AncestorType=views:SidebarView}}"
                            Command="{Binding PauseTrackingCommand, RelativeSource={RelativeSource AncestorType=views:SidebarView}}">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <material:MaterialIcon Kind="Pause" Width="18" Height="18" Foreground="{StaticResource AppWarningForeground}" />
                            <TextBlock Text="Pause" VerticalAlignment="Center" Foreground="{StaticResource AppWarningForeground}" />
                        </StackPanel>
                    </Button>

                    <Button Grid.Column="1" Classes="secondary"
                            Background="{StaticResource AppDangerBackground}"
                            Command="{Binding StartStopTrackingCommand, RelativeSource={RelativeSource AncestorType=views:SidebarView}}">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <material:MaterialIcon Kind="{Binding StartStopIcon, RelativeSource={RelativeSource AncestorType=views:SidebarView}}"
                                                   Width="18" Height="18" Foreground="{StaticResource AppDangerForeground}" />
                            <TextBlock Text="{Binding StartStopText, RelativeSource={RelativeSource AncestorType=views:SidebarView}}"
                                       VerticalAlignment="Center" Foreground="{StaticResource AppDangerForeground}" />
                        </StackPanel>
                    </Button>
                </Grid>

                <Button Classes="danger"
                        Command="{Binding ShutdownUnityAppCommand, RelativeSource={RelativeSource AncestorType=views:SidebarView}}">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <material:MaterialIcon Kind="Power" Width="18" Height="18" />
                        <TextBlock Text="Shutdown Unity App" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>

        <!-- Menu middle -->
        <Border DockPanel.Dock="Bottom" 
                Classes="card"
                Margin="0,5,0,0">
            <StackPanel Spacing="8">
                <Button Classes="nav secondary"
                        Classes.active="{Binding IsVisualizationsView, RelativeSource={RelativeSource AncestorType=views:SidebarView}}"
                        Command="{Binding NavigateVisualizationsCommand, RelativeSource={RelativeSource AncestorType=views:SidebarView}}">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <material:MaterialIcon Kind="ChartLine" Width="18" Height="18" />
                        <TextBlock Text="Visualizations" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <Button Classes="nav secondary"
                        Classes.active="{Binding IsSettingsView, RelativeSource={RelativeSource AncestorType=views:SidebarView}}"
                        Command="{Binding NavigateSettingsCommand, RelativeSource={RelativeSource AncestorType=views:SidebarView}}">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <material:MaterialIcon Kind="Cogs" Width="18" Height="18" />
                        <TextBlock Text="Session Settings" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>

        <!-- Status/Preview top -->
        <Border DockPanel.Dock="Top" Classes="card">
            <StackPanel Spacing="12">

                <StackPanel>
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                        <TextBlock
                            Text="{Binding ClientName, RelativeSource={RelativeSource AncestorType=views:SidebarView}}"
                            FontSize="16" FontWeight="Bold"
                            IsVisible="{Binding !IsEditingSessionName, RelativeSource={RelativeSource AncestorType=views:SidebarView}}" />

                        <TextBox Grid.Column="0"
                                 Text="{Binding SessionNameEdit, RelativeSource={RelativeSource AncestorType=views:SidebarView}}"
                                 Padding="6,3"
                                 IsVisible="{Binding IsEditingSessionName, RelativeSource={RelativeSource AncestorType=views:SidebarView}}" />

                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4"
                                    IsVisible="{Binding !IsEditingSessionName, RelativeSource={RelativeSource AncestorType=views:SidebarView}}">
                            <Button Classes="secondary icon"
                                    Command="{Binding StartEditSessionNameCommand, RelativeSource={RelativeSource AncestorType=views:SidebarView}}">
                                <material:MaterialIcon Kind="Pencil" Width="14" Height="14"/>
                            </Button>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4"
                                    IsVisible="{Binding IsEditingSessionName, RelativeSource={RelativeSource AncestorType=views:SidebarView}}">
                            <Button Classes="secondary icon"
                                    Command="{Binding SaveSessionNameCommand, RelativeSource={RelativeSource AncestorType=views:SidebarView}}">
                                <material:MaterialIcon Kind="Check" Width="14" Height="14"/>
                            </Button>
                            <Button Classes="secondary icon"
                                    Command="{Binding CancelSessionNameEditCommand, RelativeSource={RelativeSource AncestorType=views:SidebarView}}">
                                <material:MaterialIcon Kind="Close" Width="14" Height="14"/>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- Status line -->
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">

                        <!-- CONNECTED -->
                        <StackPanel Orientation="Horizontal" Spacing="8"
                                    IsVisible="{Binding IsConnected, RelativeSource={RelativeSource AncestorType=views:SidebarView}}">
                            <Ellipse Width="10" Height="10">
                                <Ellipse.Fill>
                                    <SolidColorBrush Color="#71c184" />
                                </Ellipse.Fill>
                            </Ellipse>
                            <TextBlock Text="Connected" Classes="secondary" VerticalAlignment="Center" />
                        </StackPanel>

                        <!-- WAITING -->
                        <StackPanel Orientation="Horizontal" Spacing="8"
                                    IsVisible="{Binding IsAwaitingConnection, RelativeSource={RelativeSource AncestorType=views:SidebarView}}">
                            <Ellipse Width="10" Height="10">
                                <Ellipse.Fill>
                                    <SolidColorBrush Color="#f59e0b" />
                                </Ellipse.Fill>
                            </Ellipse>
                            <TextBlock Text="Waiting for connection..." Classes="secondary" VerticalAlignment="Center" />
                        </StackPanel>

                        <!-- DISCONNECTED -->
                        <StackPanel Orientation="Horizontal" Spacing="8"
                                    IsVisible="{Binding IsDisconnected, RelativeSource={RelativeSource AncestorType=views:SidebarView}}">
                            <Ellipse Width="10" Height="10">
                                <Ellipse.Fill>
                                    <SolidColorBrush Color="#f24a46" />
                                </Ellipse.Fill>
                            </Ellipse>
                            <TextBlock Text="Disconnected" Classes="secondary" VerticalAlignment="Center" />
                        </StackPanel>

                    </StackPanel>
                </StackPanel>

                <Border BorderBrush="{DynamicResource SurfaceBorder}" BorderThickness="0,1,0,0" />

                <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto"
                      ColumnDefinitions="Auto,*"
                      ColumnSpacing="12"
                      RowSpacing="10">

                    <material:MaterialIcon Grid.Row="0" Grid.Column="0"
                                           Kind="Timer"
                                           Width="24" Height="24"
                                           Foreground="{DynamicResource AccentBrush}" />

                    <StackPanel Grid.Row="0" Grid.Column="1" Spacing="2">
                        <TextBlock Text="Elapsed Time" FontWeight="SemiBold" />
                        <TextBlock
                            Text="{Binding ElapsedTime,
                          RelativeSource={RelativeSource AncestorType=views:SidebarView},
                          StringFormat={}{0:hh\\:mm\\:ss}}"
                            Classes="secondary" />
                    </StackPanel>
                    
                    <material:MaterialIcon Grid.Row="1" Grid.Column="0"
                                           Kind="ChartBar"
                                           Width="24" Height="24"
                                           Foreground="{DynamicResource AccentBrush}" />

                    <StackPanel Grid.Row="1" Grid.Column="1" Spacing="2">
                        <TextBlock Text="Statements" FontWeight="SemiBold" />
                        <TextBlock
                            Text="{Binding StatementsCount,
                          RelativeSource={RelativeSource AncestorType=views:SidebarView}}"
                            Classes="secondary" />
                    </StackPanel>

                    <!-- FPS -->
                    <material:MaterialIcon Grid.Row="2" Grid.Column="0"
                                           Kind="Speedometer"
                                           Width="24" Height="24"
                                           Foreground="{DynamicResource AccentBrush}" />

                    <StackPanel Grid.Row="2" Grid.Column="1" Spacing="2">
                        <TextBlock Text="FPS" FontWeight="SemiBold" />
                        <TextBlock
                            Text="{Binding Fps,
                          RelativeSource={RelativeSource AncestorType=views:SidebarView},
                          StringFormat={}{0:0}}"
                            Classes="secondary" />
                    </StackPanel>

                    <!-- Heart Rate -->
                    <material:MaterialIcon Grid.Row="3" Grid.Column="0"
                                           Kind="HeartPulse"
                                           Width="24" Height="24"
                                           Foreground="#EF4444" />

                    <StackPanel Grid.Row="3" Grid.Column="1" Spacing="2">
                        <TextBlock Text="Heart Rate" FontWeight="SemiBold" />
                        <TextBlock
                            Text="{Binding HeartRate,
                          RelativeSource={RelativeSource AncestorType=views:SidebarView}}"
                            Classes="secondary" />
                    </StackPanel>

                    <!-- Game Objects -->
                    <material:MaterialIcon Grid.Row="4" Grid.Column="0"
                                           Kind="GamepadVariant"
                                           Width="24" Height="24"
                                           Foreground="{DynamicResource AccentBrush}" />

                    <StackPanel Grid.Row="4" Grid.Column="1" Spacing="2">
                        <TextBlock Text="Game Objects" FontWeight="SemiBold" />
                        <TextBlock
                            Text="{Binding GameObjectsCount,
                          RelativeSource={RelativeSource AncestorType=views:SidebarView}}"
                            Classes="secondary" />
                    </StackPanel>
                    
                    <material:MaterialIcon Grid.Row="5" Grid.Column="0"
                                           Kind="ProgressTick"
                                           Width="24" Height="24"
                                           Foreground="{DynamicResource AccentBrush}" />
                    
                    <StackPanel Grid.Row="5" Grid.Column="1" Spacing="2">
                        <TextBlock Text="Score" FontWeight="SemiBold" />
                        <TextBlock
                            Text="{Binding ScoreProgressValue,
                          RelativeSource={RelativeSource AncestorType=views:SidebarView},
                          StringFormat={}{0:0.000}%}"
                            Classes="secondary" />
                    </StackPanel>
                </Grid>

                
            </StackPanel>
        </Border>

    </DockPanel>
</UserControl>
