<sukiUi:SukiWindow xmlns="https://github.com/avaloniaui"
                   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                   xmlns:views="clr-namespace:ReCoPa.Views"
                   xmlns:vm="clr-namespace:ReCoPa.ViewModels"
                   x:Class="ReCoPa.Views.MainWindow"
                   x:DataType="vm:MainViewModel"
                   xmlns:sukiUi="clr-namespace:SukiUI.Controls;assembly=SukiUI"
                   Width="1000"
                   Height="700"
                   Title="ReCoPa - Researcher Companion Panel"
                   Icon="/Assets/app-icon.png"
                   BackgroundStyle="Gradient">
    
    <sukiUi:SukiWindow.LogoContent>
        <Image Source="avares://ReCoPa/Assets/app-icon.png" Width="32" Height="32"/>        <!-- Logo -->
    </sukiUi:SukiWindow.LogoContent>

    <ScrollViewer>
        
         <DockPanel>
            <views:DashboardView />
        </DockPanel>
        
        <!--<Border Padding="20" Classes="card">
            <StackPanel Spacing="16">
                <TextBlock Text="Connected Clients" FontSize="22" FontWeight="Bold"/>
                <views:ClientsTableView DataContext="{Binding ClientsTableViewModel}" />
                <views:VisualizationContainerView />
                <Button Content="Manage Plugins" Click="OpenPlugins"/>
                <Button Content="Quit App" HorizontalAlignment="Left" Command="{Binding QuitAppCommand}" />
            </StackPanel>
        </Border>-->
    </ScrollViewer>
</sukiUi:SukiWindow>