<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:ReCoPa.ViewModels"
             xmlns:views="clr-namespace:ReCoPa.Views"
             x:Class="ReCoPa.Views.DashboardView"
             x:DataType="vm:DashboardViewModel">

    <DockPanel>

        <!-- TOP BAR: Logo + Tabs + New Client (alles eine Zeile) -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource SurfaceElevated}" Padding="12" BorderBrush="{DynamicResource SurfaceBorder}" BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                
                <!-- Middle: Client Tabs -->
                <ItemsControl Grid.Column="0" ItemsSource="{Binding ClientTabs}" Margin="16,0">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>

                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <views:TabView
                                Header="{Binding Header}"
                                IsActive="{Binding IsActive}"
                                Margin="0,0,10,0" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Right: Add Client -->
                <Button Grid.Column="1"
                        Content="+ New Session"
                        Command="{Binding AddClientCommand}"
                        Classes="secondary"
                        Padding="12,8"
                        CornerRadius="10"/>
            </Grid>
        </Border>

        <!-- MAIN -->
        <Grid ColumnDefinitions="320,*">
            <!-- Sidebar -->
            <views:SidebarView Grid.Column="0"
                              ClientName="{Binding SelectedClientName}"
                              IsConnected="{Binding IsSelectedClientConnected}"
                              IsDisconnected="{Binding IsSelectedClientDisconnected}"
                              XapiStatementsCount="{Binding SelectedClientXapiStatementsCount}"
                              GameObjectsCount="{Binding SelectedClientGameObjectsCount}"
                              Fps="{Binding SelectedClientFps}"
                              HeartRate="{Binding SelectedClientHeartRate}"
                              NavigateVisualizationsCommand="{Binding NavigateVisualizationsCommand}"
                              NavigateSettingsCommand="{Binding NavigateSettingsCommand}"
                              StartEyeCalibrationCommand="{Binding StartCalibrationCommand}"
                              PauseTrackingCommand="{Binding PauseTrackingCommand}"
                              StopTrackingCommand="{Binding StopTrackingCommand}"
                              ShutdownUnityAppCommand="{Binding ShutdownAppCommand}"
                              />

            <!-- Content (bei dir erstmal wie gehabt) -->
            <views:StatementListView Grid.Column="1" />
        </Grid>

    </DockPanel>
</UserControl>