<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ReCoPa.Views.ClientsTableView">

    <VerticalStackLayout Spacing="8">

        <Grid ColumnDefinitions="2*,3*,2*,2*,Auto" Padding="8,6" BackgroundColor="#222">
            <Label Text="Id" TextColor="White" FontAttributes="Bold"/>
            <Label Grid.Column="1" Text="Remote" TextColor="White" FontAttributes="Bold"/>
            <Label Grid.Column="2" Text="Type" TextColor="White" FontAttributes="Bold"/>
            <Label Grid.Column="3" Text="Version" TextColor="White" FontAttributes="Bold"/>
            <Label Grid.Column="4" Text="Action" TextColor="White" FontAttributes="Bold"/>
        </Grid>

        <CollectionView ItemsSource="{Binding Clients, Source={RelativeSource AncestorType={x:Type ContentView}}}"
                        SelectionMode="None">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Grid ColumnDefinitions="2*,3*,2*,2*,Auto" Padding="8,6">
                        <Label Text="{Binding Id}" LineBreakMode="TailTruncation"/>
                        <Label Grid.Column="1" Text="{Binding RemoteEndPoint}" LineBreakMode="TailTruncation"/>
                        <Label Grid.Column="2" Text="{Binding ClientType}" LineBreakMode="TailTruncation"/>
                        <Label Grid.Column="3" Text="{Binding Version}" LineBreakMode="TailTruncation"/>

                        <Button Grid.Column="4"
                                Text="Quit"
                                Padding="10,2"
                                Clicked="QuitButton_OnClicked"
                                CommandParameter="{Binding .}" />
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

    </VerticalStackLayout>
</ContentView>