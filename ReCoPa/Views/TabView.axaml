<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:ReCoPa.Views"
             x:Class="ReCoPa.Views.TabView">
    <Button
        Classes.active="{Binding IsActive, RelativeSource={RelativeSource AncestorType=views:TabView}}"
        Content="{Binding Header, RelativeSource={RelativeSource AncestorType=views:TabView}}"
        Padding="10,20"
        Margin="0, 0"
        CornerRadius="6"/>
</UserControl>