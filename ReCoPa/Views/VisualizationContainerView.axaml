<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="clr-namespace:ReCoPa.ViewModels"
    xmlns:material="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
    x:Class="ReCoPa.Views.VisualizationContainerView"
    x:Name="Root"
    x:DataType="vm:VisualizationContainerViewModel">

    <UserControl.Styles>

        <!-- Hover-Actions ein-/ausblenden -->
        <Style Selector="Border.visTile Grid#HeaderActions">
            <Setter Property="Opacity" Value="0"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.12"/>
                </Transitions>
            </Setter>
        </Style>

        <Style Selector="Border.visTile:pointerover Grid#HeaderActions">
            <Setter Property="Opacity" Value="1"/>
            <Setter Property="IsHitTestVisible" Value="True"/>
        </Style>

        <!-- Drag target highlight -->
        <Style Selector="Border.visTile.drag-target">
            <Setter Property="BorderBrush" Value="#B3B3B3"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="#11000000"/>
        </Style>

    </UserControl.Styles>

    <DockPanel>

        <!-- Top bar: Add / Layout -->
        <Border DockPanel.Dock="Top" Classes="card" Padding="0,10,10,10">
            <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="10">

                <ComboBox Grid.Column="0"
                          ItemsSource="{Binding AvailableVisualizations}"
                          SelectedItem="{Binding SelectedToAdd}"
                          MinWidth="260">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Name}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                    <TextBlock Text="Cols" Classes="secondary" FontSize="11" />
                    <NumericUpDown Value="{Binding GridColumns}"
                                   Minimum="1"
                                   Maximum="12"
                                   FormatString="0"
                                   Width="70" />
                </StackPanel>

                <StackPanel Grid.Column="2" Spacing="4" VerticalAlignment="Center">
                    <TextBlock Text="Rows" Classes="secondary" FontSize="11" />
                    <NumericUpDown Value="{Binding GridRows}"
                                   Minimum="1"
                                   Maximum="12"
                                   FormatString="0"
                                   Width="70" />
                </StackPanel>

                <Button Grid.Column="3"
                        Classes="secondary"
                        Command="{Binding AddVisualizationCommand}">
                    <TextBlock Text="Add" />
                </Button>
            </Grid>
        </Border>

        <!-- Grid area -->
        <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                      Padding="5,0,0,0"
                      Margin="0,5,0,0"
                      VerticalScrollBarVisibility="Auto">

            <ItemsControl ItemsSource="{Binding Views}">

                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid x:CompileBindings="False"
                                     Columns="{Binding DataContext.GridColumns, ElementName=Root}"
                                     Rows="{Binding DataContext.GridRows, ElementName=Root}" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:VisualizationHostItem" x:CompileBindings="False">

                        <!-- Tile -->
                        <Border Classes="card visTile"
                                ClipToBounds="True"
                                PointerPressed="OnTilePointerPressed"
                                DragDrop.DragOver="OnTileDragOver"
                                DragDrop.Drop="OnTileDrop"
                                DragDrop.DragLeave="OnTileDragLeave"
                                DragDrop.AllowDrop="True"
                                Margin="6">

                            <Grid RowDefinitions="Auto,*">

                                <!-- header (title + actions) -->
                                <Grid ColumnDefinitions="*,Auto,Auto"
                                      ColumnSpacing="8"
                                      Margin="8,6"
                                      Background="Transparent">
                                    <TextBlock Text="{Binding Title}"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center"/>

                                    <Grid Grid.Column="1"
                                          ColumnDefinitions="Auto,Auto"
                                          ColumnSpacing="6"
                                          Name="HeaderActions">
                                        <!-- Settings (nur wenn SettingsView existiert) -->
                                        <Button Classes="secondary"
                                                Padding="6"
                                                IsVisible="{Binding HasSettingsView}"
                                                Command="{Binding #Root.DataContext.ToggleSettingsCommand}"
                                                CommandParameter="{Binding}">
                                            <material:MaterialIcon Kind="Cog" Width="16" Height="16"/>
                                        </Button>

                                        <!-- Remove -->
                                        <Button Grid.Column="1"
                                                Classes="secondary"
                                                Padding="6"
                                                Command="{Binding #Root.DataContext.RemoveVisualizationCommand}"
                                                CommandParameter="{Binding}">
                                            <material:MaterialIcon Kind="Trash" Width="16" Height="16"/>
                                        </Button>
                                    </Grid>
                                </Grid>

                                <!-- content -->
                                <ContentPresenter Grid.Row="1" Content="{Binding View}" />

                                <!-- Settings overlay -->
                                <Border Background="#99000000"
                                        Grid.RowSpan="2"
                                        IsVisible="{Binding IsSettingsOpen}"
                                        Padding="12">

                                    <Border Classes="card" Padding="12" MaxWidth="520" Background="White">
                                        <Grid RowDefinitions="Auto,*" RowSpacing="10">

                                            <Grid ColumnDefinitions="*,Auto">
                                                <TextBlock Text="{Binding Title}"
                                                           FontSize="14"
                                                           FontWeight="SemiBold"/>

                                                <Button Grid.Column="1"
                                                        Classes="secondary"
                                                        Padding="6"
                                                        Command="{Binding #Root.DataContext.ToggleSettingsCommand}"
                                                        CommandParameter="{Binding}">
                                                    <material:MaterialIcon Kind="Close" Width="16" Height="16"/>
                                                </Button>
                                            </Grid>

                                            <!-- Wenn SettingsView null: placeholder -->
                                            <Grid Grid.Row="1">
                                                <ContentPresenter Content="{Binding SettingsView}"
                                                                  IsVisible="{Binding HasSettingsView}" />

                                                <TextBlock Text="No settings available."
                                                           Opacity="0.8"
                                                           IsVisible="{Binding !HasSettingsView}" />
                                            </Grid>

                                        </Grid>
                                    </Border>

                                </Border>

                            </Grid>
                        </Border>

                    </DataTemplate>
                </ItemsControl.ItemTemplate>

            </ItemsControl>
        </ScrollViewer>

    </DockPanel>
</UserControl>
