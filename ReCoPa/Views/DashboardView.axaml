<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:ReCoPa.ViewModels"
             xmlns:views="clr-namespace:ReCoPa.Views"
             xmlns:visualizations="clr-namespace:ReCoPa.Views.Visualizations"
             x:Class="ReCoPa.Views.DashboardView"
             x:DataType="vm:DashboardViewModel">

    <DockPanel>

        <views:TabsHeaderView DockPanel.Dock="Top"
                              Items="{Binding ClientTabs}"
                              SelectTabCommand="{Binding SelectTabCommand}"
                              AddClientCommand="{Binding AddClientCommand}"/>

        <!-- MAIN -->
        <Grid ColumnDefinitions="250,*">
            <!-- Sidebar -->
            <views:SidebarView Grid.Column="0"
                               ClientName="{Binding SelectedClientName}"
                               IsConnected="{Binding IsSelectedClientConnected}"
                               IsDisconnected="{Binding IsSelectedClientDisconnected}"
                               XapiStatementsCount="{Binding SelectedClientXapiStatementsCount}"
                               GameObjectsCount="{Binding SelectedClientGameObjectsCount}"
                               Fps="{Binding SelectedClientFps}"
                               HeartRate="{Binding SelectedClientHeartRate}"
                               NavigateVisualizationsCommand="{Binding NavigateVisualizationsCommand}"
                               NavigateSettingsCommand="{Binding NavigateSettingsCommand}"
                               StartEyeCalibrationCommand="{Binding StartCalibrationCommand}"
                               PauseTrackingCommand="{Binding PauseTrackingCommand}"
                               StopTrackingCommand="{Binding StopTrackingCommand}"
                               ShutdownUnityAppCommand="{Binding ShutdownAppCommand}" />

            <!-- Content (bei dir erstmal wie gehabt) -->
            <views:VisualizationContainerView Grid.Column="1" />
            <visualizations:PulseMonitorView Grid.Column="1"></visualizations:PulseMonitorView>
        </Grid>

    </DockPanel>
</UserControl>