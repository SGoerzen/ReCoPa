<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Brand (Logo) -->
    <SolidColorBrush x:Key="AppPrimaryColor"        Color="#005098"/>
    <SolidColorBrush x:Key="AppPrimaryColorHover"   Color="#0B5AA8"/>
    <SolidColorBrush x:Key="AppPrimaryColorPressed" Color="#003769"/>
    
    <!-- Tab selection -->
    <SolidColorBrush x:Key="TabActiveBackground"   Color="#F1F1F1"/>  
    <SolidColorBrush x:Key="TabInactiveBackground" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="TabActiveForeground"   Color="#0F172A"/>
    <SolidColorBrush x:Key="TabInactiveForeground" Color="#0F172A"/>

    <!-- Surfaces -->
    <SolidColorBrush x:Key="SurfaceBackground" Color="#F5F7FA"/>
    <SolidColorBrush x:Key="SurfaceElevated"   Color="#FFFFFF"/>
    <SolidColorBrush x:Key="SurfaceCard"       Color="#FFFFFF"/>
    <SolidColorBrush x:Key="SurfaceHover"      Color="#EEF3F8"/>
    <SolidColorBrush x:Key="SurfaceSelected"   Color="#D6E7F7"/>

    <!-- Borders -->
    <SolidColorBrush x:Key="SurfaceBorder"       Color="#D9E1EA"/>
    <SolidColorBrush x:Key="SurfaceBorderStrong" Color="#BFCAD6"/>

    <!-- Text -->
    <SolidColorBrush x:Key="TextPrimary"   Color="#0F172A"/>
    <SolidColorBrush x:Key="TextSecondary" Color="#64748B"/>
    <SolidColorBrush x:Key="TextDisabled"  Color="#9AA6B2"/>
    <SolidColorBrush x:Key="TextOnPrimary" Color="#FFFFFF"/>

    <!-- Danger -->
    <SolidColorBrush x:Key="AppDangerBackground" Color="#f24a46"/>
    <SolidColorBrush x:Key="AppDangerForeground" Color="#ffffff"/>
    
    <!-- Warning -->
    <SolidColorBrush x:Key="AppWarningBackground" Color="#f5a726"/>
    <SolidColorBrush x:Key="AppWarningForeground" Color="#ffffff"/>
    
    <!-- Success -->
    <SolidColorBrush x:Key="AppSuccessBackground" Color="#71c184"/>
    <SolidColorBrush x:Key="AppSuccessForeground" Color="#ffffff"/>
</ResourceDictionary>