<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:views="clr-namespace:ReCoPa.Views"
             x:Class="ReCoPa.MainPage">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="16">

            <Label Text="Connected Clients" FontSize="22" FontAttributes="Bold"/>

            <views:ClientsTableView Clients="{Binding Clients}" />

            <Button Text="Quit App"
                    Clicked="KillAppBtn_OnClicked" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>