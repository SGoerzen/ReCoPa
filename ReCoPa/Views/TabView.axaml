<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:ReCoPa.Views"
             x:Class="ReCoPa.Views.TabView">

    <UserControl.Styles>

        <!-- Default: white -->
        <Style Selector="Button#TabButton">
            <Setter Property="CornerRadius" Value="10,10,0,0"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SurfaceBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Focusable" Value="True"/>
            <Setter Property="IsHitTestVisible" Value="True"/>
        </Style>

        <!-- Hover -->
        <Style Selector="Button#TabButton:pointerover">
            <Setter Property="Background" Value="{DynamicResource SurfaceHover}"/>
        </Style>

        <!-- Selected/Active -->
        <Style Selector="views|TabView[IsActive=True] Button#TabButton">
            <Setter Property="Margin" Value="0,0,0,-1"/>
            <Setter Property="Background" Value="{DynamicResource TabActiveBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource TabActiveForeground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource TabActiveBorder}"/>

            <!-- IMPORTANT: make it not clickable + no hover/focus -->
            <Setter Property="IsHitTestVisible" Value="False"/>
            <Setter Property="Focusable" Value="False"/>
        </Style>

    </UserControl.Styles>

    <Button x:Name="TabButton"
            ZIndex="100"
            Content="{Binding Header, RelativeSource={RelativeSource AncestorType=views:TabView}}"
            Command="{Binding SelectCommand, RelativeSource={RelativeSource AncestorType=views:TabView}}"
            CommandParameter="{Binding SelectCommandParameter, RelativeSource={RelativeSource AncestorType=views:TabView}}"/>
</UserControl>