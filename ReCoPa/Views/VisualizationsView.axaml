<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:ReCoPa.ViewModels"
             x:Class="ReCoPa.Views.VisualizationsView"
             x:DataType="vm:VisualizationsViewModel">

  <ScrollViewer>
    <StackPanel Margin="16" Spacing="12">

      <TextBlock Text="Visualizations" FontSize="20" FontWeight="Bold"/>

      <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
        <Border Classes="card">
          <StackPanel Spacing="8">
            <TextBlock Text="Live Metrics" FontWeight="SemiBold"/>
            <TextBlock Text="{Binding LiveSummary}" Classes="secondary"/>
            <Border Height="180" Background="{DynamicResource SurfaceHover}" CornerRadius="10"/>
            <TextBlock Text="(Chart placeholder: FPS / HR over time)" Classes="secondary"/>
          </StackPanel>
        </Border>

        <Border Classes="card">
          <StackPanel Spacing="8">
            <TextBlock Text="Statement Rate" FontWeight="SemiBold"/>
            <TextBlock Text="{Binding StatementRateText}" Classes="secondary"/>
            <Border Height="180" Background="{DynamicResource SurfaceHover}" CornerRadius="10"/>
            <TextBlock Text="(Chart placeholder: statements/sec)" Classes="secondary"/>
          </StackPanel>
        </Border>
      </Grid>

      <Border Classes="card">
        <StackPanel Spacing="10">
          <TextBlock Text="Latest Statements" FontWeight="SemiBold"/>

          <ItemsControl ItemsSource="{Binding LatestStatements}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Background="{DynamicResource SurfaceHover}" CornerRadius="10" Padding="10" Margin="0,0,0,8">
                  <StackPanel Spacing="2">
                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding Subtitle}" Classes="secondary"/>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

        </StackPanel>
      </Border>

    </StackPanel>
  </ScrollViewer>
</UserControl>