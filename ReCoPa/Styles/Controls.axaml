<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:ReCoPa.Views">

    <!-- ========================================================= -->
    <!-- WINDOW                                                    -->
    <!-- ========================================================= -->

    <Style Selector="Window">
        <Setter Property="Background" Value="{DynamicResource SurfaceBackground}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
    </Style>

    <!-- ========================================================= -->
    <!-- TEXTBLOCK / LABELS                                        -->
    <!-- ========================================================= -->

    <Style Selector="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
        <Setter Property="FontSize" Value="13"/>
    </Style>

    <Style Selector="TextBlock.secondary">
        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
    </Style>

    <Style Selector="TextBlock.title">
        <Setter Property="FontSize" Value="22"/>
        <Setter Property="FontWeight" Value="Bold"/>
    </Style>

    <!-- ========================================================= -->
    <!-- BUTTONS                                                   -->
    <!-- ========================================================= -->

    <!-- Default button -->
    <Style Selector="Button">
        <Setter Property="Background" Value="{DynamicResource AppPrimaryColor}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextOnPrimary}"/>
        <Setter Property="Padding" Value="12,6"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <!-- small polish -->
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AppPrimaryColorPressed}"/>
    </Style>

    <Style Selector="Button:pointerover">
        <Setter Property="Background" Value="{DynamicResource AppPrimaryColorHover}"/>
    </Style>

    <Style Selector="Button:pressed">
        <Setter Property="Background" Value="{DynamicResource AppPrimaryColorPressed}"/>
    </Style>

    <Style Selector="Button:disabled">
        <Setter Property="Background" Value="{DynamicResource SurfaceBorder}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextDisabled}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource SurfaceBorderStrong}"/>
    </Style>

    <!-- Secondary button -->
    <Style Selector="Button.secondary">
        <Setter Property="Background" Value="{DynamicResource SurfaceElevated}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource SurfaceBorderStrong}"/>
        <Setter Property="BorderThickness" Value="1"/>
    </Style>

    <Style Selector="Button.secondary:pointerover">
        <Setter Property="Background" Value="{DynamicResource SurfaceHover}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AppPrimaryColor}"/>
    </Style>

    <!-- Danger button -->
    <Style Selector="Button.danger">
        <Setter Property="Background" Value="{DynamicResource AppDangerColor}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AppDangerColor}"/>
        <Setter Property="BorderThickness" Value="1"/>
    </Style>

    <!-- ========================================================= -->
    <!-- TEXTBOX                                                   -->
    <!-- ========================================================= -->

    <Style Selector="TextBox">
        <Setter Property="Background" Value="{DynamicResource SurfaceCard}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource SurfaceBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="Padding" Value="8,5"/>
    </Style>

    <Style Selector="TextBox:pointerover">
        <Setter Property="BorderBrush" Value="{DynamicResource SurfaceBorderStrong}"/>
    </Style>

    <Style Selector="TextBox:focus">
        <Setter Property="BorderBrush" Value="{DynamicResource AppPrimaryColor}"/>
        <Setter Property="BorderThickness" Value="2"/>
    </Style>

    <!-- ========================================================= -->
    <!-- CHECKBOX                                                  -->
    <!-- ========================================================= -->

    <Style Selector="CheckBox">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
    </Style>

    <!-- ========================================================= -->
    <!-- SCROLLVIEWER                                              -->
    <!-- ========================================================= -->

    <Style Selector="ScrollViewer">
        <Setter Property="Background" Value="{DynamicResource SurfaceBackground}"/>
    </Style>

    <!-- ========================================================= -->
    <!-- COMBOBOX (needed for your filter dropdown)                -->
    <!-- ========================================================= -->

    <Style Selector="ComboBox">
        <Setter Property="Background" Value="{DynamicResource SurfaceCard}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource SurfaceBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="Padding" Value="8,5"/>
    </Style>

    <Style Selector="ComboBox:pointerover">
        <Setter Property="BorderBrush" Value="{DynamicResource SurfaceBorderStrong}"/>
    </Style>

    <Style Selector="ComboBox:focus">
        <Setter Property="BorderBrush" Value="{DynamicResource AppPrimaryColor}"/>
        <Setter Property="BorderThickness" Value="2"/>
    </Style>

    <!-- ========================================================= -->
    <!-- DATAGRID                                                  -->
    <!-- ========================================================= -->

    <Style Selector="DataGrid">
        <Setter Property="Background" Value="{DynamicResource SurfaceBackground}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource SurfaceBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="RowHeight" Value="36"/>
        <Setter Property="HeadersVisibility" Value="Column"/>
        <Setter Property="GridLinesVisibility" Value="Horizontal"/>
    </Style>

    <Style Selector="DataGridColumnHeader">
        <Setter Property="Background" Value="{DynamicResource SurfaceElevated}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Padding" Value="10,6"/>
        <Setter Property="BorderBrush" Value="{DynamicResource SurfaceBorder}"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
    </Style>

    <Style Selector="DataGridRow">
        <Setter Property="Background" Value="{DynamicResource SurfaceBackground}"/>
    </Style>

    <Style Selector="DataGridRow:pointerover">
        <Setter Property="Background" Value="{DynamicResource SurfaceHover}"/>
    </Style>

    <Style Selector="DataGridRow:selected">
        <!-- logo-ish selection (soft blue) -->
        <Setter Property="Background" Value="{DynamicResource SurfaceSelected}"/>
    </Style>

    <Style Selector="DataGridCell">
        <Setter Property="Padding" Value="10,4"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>

    <!-- ========================================================= -->
    <!-- BORDER / CARD                                             -->
    <!-- ========================================================= -->

    <Style Selector="Border.card">
        <Setter Property="Background" Value="{DynamicResource SurfaceCard}"/>
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="Padding" Value="14"/>
        <Setter Property="BorderBrush" Value="{DynamicResource SurfaceBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
    </Style>

    <!-- ========================================================= -->
    <!-- TABVIEW (Selection look)                                  -->
    <!-- Requires TabView.axaml Button to have: Classes.active="{Binding IsActive ...}" -->
    <!-- ========================================================= -->

    <Style Selector="views|TabView Button">
        <Setter Property="Background" Value="{DynamicResource TabInactiveBackground}"/>
        <Setter Property="Foreground" Value="{DynamicResource TabInactiveForeground}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource SurfaceBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="Padding" Value="12,8"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <Style Selector="views|TabView Button:pointerover">
        <Setter Property="Background" Value="{DynamicResource SurfaceHover}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource SurfaceBorderStrong}"/>
    </Style>

    <Style Selector="views|TabView Button.active">
        <Setter Property="Background" Value="{DynamicResource TabActiveBackground}"/>
        <Setter Property="Foreground" Value="{DynamicResource TabActiveForeground}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AppPrimaryColor}"/>
    </Style>

    <Style Selector="views|TabView Button.active:pressed">
        <Setter Property="Background" Value="{DynamicResource SurfaceSelected}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AppPrimaryColorPressed}"/>
    </Style>
    
    <Style Selector="Button.nav">
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="Padding" Value="10,8"/>
        <Setter Property="CornerRadius" Value="10"/>
    </Style>

    <Style Selector="Button.nav.active">
        <Setter Property="Background" Value="{DynamicResource SurfaceSelected}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource SurfaceBorderStrong}"/>
        <Setter Property="BorderThickness" Value="1"/>
    </Style>

    <!-- Tab button default -->
    <Style Selector="Button.tab">
        <Setter Property="Background" Value="{DynamicResource SurfaceHover}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource SurfaceBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
    </Style>

    <Style Selector="Button.tab:pointerover">
        <Setter Property="Background" Value="{DynamicResource SurfaceSelected}"/>
    </Style>

    <!-- Selected/Active tab -->
    <Style Selector="views|TabView[IsActive=True] Button.tab">
        <Setter Property="Background" Value="{DynamicResource AppPrimaryColor}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextOnPrimary}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AppPrimaryColor}"/>
    </Style>
    
    <Style Selector="ToggleSwitch:disabled">
        <Setter Property="Opacity" Value="0.45"/>
    </Style>
</Styles>
